FROM ubuntu:20.04

# Installer cron et d'autres d=C3=A9pendances n=C3=A9cessaires
RUN apt-get update &amp;&amp; apt-get install -y cron

# Copier le script de cron =C3=A0 ex=C3=A9cuter dans le conteneur
COPY my_cron_script.sh /usr/local/bin/my_cron_script.sh

# Rendre le script ex=C3=A9cutable
RUN chmod +x /usr/local/bin/my_cron_script.sh

# Ajouter le cron job dans le crontab
