guage-dockerfile"><span># =C3=89tape 1: Builder l'application
FROM node:14 AS builder

# D=C3=A9finir le r=C3=A9pertoire de travail
WORKDIR /app

# Copier les fichiers de l'application
COPY package.json package-lock.json ./

# Installer les d=C3=A9pendances
RUN npm install

# Copier le reste du code
COPY . .

# Construire l'application (par exemple pour une app React)
RUN npm run build

# =C3=89tape 2: Cr=C3=A9er l'image de production
FROM node:14-slim

# D=C3=A9finir le r=C3=A9pertoire de travail
WORKDIR /app

# Copier uniquement les fichiers n=C3=A9cessaires depuis l'=C3=A9tape de bu=
ild
COPY --from=3Dbuilder /app/build /app/build

# Copier les d=C3=A9pendances de production
COPY --from=3Dbuilder /app/node_modules /app/node_modules

# Exposer le port sur lequel l'application =C3=A9coute
EXPOSE 3000

# Lancer l'application
CMD ["npm", "start"]
