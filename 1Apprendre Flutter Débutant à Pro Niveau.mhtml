  double _scale =3D 1.0;

  void _onScaleUpdate(ScaleUpdateDetails details) {
    setState(() {
      _scale =3D details.scale;
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: GestureDetector(
        onScaleUpdate: _onScaleUpdate,
        child: Center(
          child: Transform.scale(
            scale: _scale,
            child: Container(
              width: 200,
              height: 200,
              color: Colors.purple,
              child: Center(child: Text("Pincez-moi")),
            ),
          ),
        ),
      ),
    );
