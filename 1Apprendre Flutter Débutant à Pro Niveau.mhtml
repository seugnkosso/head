age-dart"><span>import 'package:flutter/material.dart';
import 'package:your_project/repositories/product_repository.dart';
import 'package:your_project/models/product.dart';

class HomeViewModel extends ChangeNotifier {
  final ProductRepository _productRepository;
  List&lt;Product&gt; _products =3D [];
  bool _isLoading =3D false;

  HomeViewModel(this._productRepository);

  List&lt;Product&gt; get products =3D&gt; _products;
  bool get isLoading =3D&gt; _isLoading;

  // R=C3=A9cup=C3=A9rer les produits
  Future&lt;void&gt; fetchProducts() async {
    _isLoading =3D true;
    notifyListeners();

    try {
      _products =3D await _productRepository.getProducts();
    } catch (e) {
      // G=C3=A9rer les erreurs
      print('Erreur lors de la r=C3=A9cup=C3=A9ration des produits: $e');
    } finally {
      _isLoading =3D false;
      notifyListeners();
    }
  }
}
