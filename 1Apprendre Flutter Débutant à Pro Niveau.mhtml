ster) async {
    // Cr=C3=A9e et lance l'application
    await tester.pumpWidget(MyApp());

    // V=C3=A9rifie que le texte initial est affich=C3=A9
    expect(find.text('You pressed the button 0 times'), findsOneWidget);

    // Simule un tap sur le bouton
    await tester.tap(find.byType(ElevatedButton));
    await tester.pump();

    // V=C3=A9rifie que le compteur a =C3=A9t=C3=A9 incr=C3=A9ment=C3=A9
    expect(find.text('You pressed the button 1 times'), findsOneWidget);
  });
}
