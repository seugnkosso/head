age-dart"><span>import 'package:sqflite/sqflite.dart';
import 'package:path/path.dart';

class DatabaseHelper {
  Future&lt;Database&gt; database;

  DatabaseHelper() {
    database =3D _initDb();
  }

  Future&lt;Database&gt; _initDb() async {
    return openDatabase(
      join(await getDatabasesPath(), 'my_database.db'),
      onCreate: (db, version) {
        return db.execute(
          'CREATE TABLE notes(id INTEGER PRIMARY KEY, title TEXT, content T=
EXT)',
        );
      },
      version: 1,
    );
  }

  Future&lt;void&gt; insertNote(Note note) async {
    final db =3D await database;
    await db.insert('notes', note.toMap(), conflictAlgorithm: ConflictAlgor=
ithm.replace);
  }

  Future&lt;List&lt;Note&gt;&gt; getNotes() async {
    final db =3D await database;
    final List&lt;Map&lt;String, dynamic&gt;&gt; maps =3D await db.query('n=
otes');
    return List.generate(maps.length, (i) {
      return Note(
        id: maps[i]['id'],
        title: maps[i]['title'],
        content: maps[i]['content'],
      );
    });
  }
}

class Note {
  final int id;
  final String title;
  final String content;

  Note({this.id, this.title, this.content});

  Map&lt;String, dynamic&gt; toMap() {
    return {
      'id': id,
      'title': title,
      'content': content,
    };
  }
}
