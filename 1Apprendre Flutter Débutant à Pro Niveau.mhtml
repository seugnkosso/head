age-dart"><span>import 'dart:convert';
import 'package:http/http.dart' as http;
import '../models/user.dart';

class UserRepository {
  final String baseUrl;

  UserRepository(this.baseUrl);

  // Fonction pour r=C3=A9cup=C3=A9rer les utilisateurs depuis l'API
  Future&lt;List&lt;User&gt;&gt; getUsers() async {
    final response =3D await http.get(Uri.parse('$baseUrl/users'));

    if (response.statusCode =3D=3D 200) {
      final List&lt;dynamic&gt; data =3D json.decode(response.body);
      return data.map((json) =3D&gt; User.fromMap(json)).toList();
    } else {
      throw Exception('Failed to load users');
    }
  }

  // Fonction pour r=C3=A9cup=C3=A9rer un utilisateur sp=C3=A9cifique par s=
on ID
  Future&lt;User&gt; getUserById(int id) async {
    final response =3D await http.get(Uri.parse('$baseUrl/users/$id'));

    if (response.statusCode =3D=3D 200) {
      final data =3D json.decode(response.body);
      return User.fromMap(data);
    } else {
      throw Exception('Failed to load user');
    }
  }

  // Fonction pour ajouter un nouvel utilisateur
  Future&lt;User&gt; addUser(User user) async {
    final response =3D await http.post(
      Uri.parse('$baseUrl/users'),
      headers: {"Content-Type": "application/json"},
      body: json.encode(user.toMap()),
    );

    if (response.statusCode =3D=3D 201) {
      final data =3D json.decode(response.body);
      return User.fromMap(data);
    } else {
      throw Exception('Failed to add user');
    }
  }
}
