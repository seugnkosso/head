<hr data-start=3D"7195" data-end=3D"7198" class=3D"">
<h2 data-start=3D"7200" data-end=3D"7243" class=3D""><strong data-start=3D"=
7203" data-end=3D"7243">8. R=C3=A9sum=C3=A9 des commandes essentielles</str=
ong></h2>
<div class=3D"overflow-x-auto contain-inline-size"><table data-start=3D"724=
5" data-end=3D"7900" node=3D"[object Object]"><thead data-start=3D"7245" da=
