"7245" data-end=3D"7283">Commande</th><th data-start=3D"7283" data-end=3D"7=
298">Description</th></tr></thead><tbody data-start=3D"7353" data-end=3D"79=
00"><tr data-start=3D"7353" data-end=3D"7451"><td><code data-start=3D"7355"=
 data-end=3D"7377">git push origin main</code></td><td>Pousse la branche <c=
ode data-start=3D"7411" data-end=3D"7417">main</code> vers le d=C3=A9p=C3=
=B4t distant <code data-start=3D"7440" data-end=3D"7448">origin</code>.</td=
></tr><tr data-start=3D"7452" data-end=3D"7566"><td><code data-start=3D"745=
4" data-end=3D"7479">git push -u origin main</code></td><td>Pousse la branc=
he <code data-start=3D"7510" data-end=3D"7516">main</code> et lie la branch=
e locale =C3=A0 la branche distante.</td></tr><tr data-start=3D"7567" data-=
end=3D"7670"><td><code data-start=3D"7569" data-end=3D"7596">git push origi=
n &lt;branche&gt;</code></td><td>Pousse une branche sp=C3=A9cifique vers le=
 d=C3=A9p=C3=B4t distant <code data-start=3D"7659" data-end=3D"7667">origin=
</code>.</td></tr><tr data-start=3D"7671" data-end=3D"7764"><td><code data-=
start=3D"7673" data-end=3D"7703">git push -u origin &lt;branche&gt;</code><=
/td><td>Pousse une branche et la lie =C3=A0 la branche distante.</td></tr><=
tr data-start=3D"7765" data-end=3D"7900"><td><code data-start=3D"7767" data=
