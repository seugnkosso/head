<ol data-start=3D"1905" data-end=3D"2063">
<li data-start=3D"1905" data-end=3D"1994" class=3D"">
<p data-start=3D"1908" data-end=3D"1994" class=3D"">Elle r=C3=A9cup=C3=A8re=
 les modifications de la branche <code data-start=3D"1954" data-end=3D"1960=
">main</code> depuis le d=C3=A9p=C3=B4t distant <code data-start=3D"1985" d=
ata-end=3D"1993">origin</code>.</p>
</li>
<li data-start=3D"1995" data-end=3D"2063" class=3D"">
<p data-start=3D"1998" data-end=3D"2063" class=3D"">Elle fusionne ces modif=
ications dans votre branche locale <code data-start=3D"2056" data-end=3D"20=
62">main</code>.</p>
</li>
</ol>
