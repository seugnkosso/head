<ul data-start=3D"3866" data-end=3D"4029">
<li data-start=3D"3866" data-end=3D"3936">
<p data-start=3D"3868" data-end=3D"3936"><code data-start=3D"3868" data-end=
=3D"3879">git merge</code> pr=C3=A9serve l=E2=80=99historique complet avec =
