</li>
<li data-start=3D"2309" data-end=3D"2379" class=3D"">
<p data-start=3D"2311" data-end=3D"2379" class=3D""><strong data-start=3D"2=
311" data-end=3D"2342">Choisir un mod=C3=A8le de projet</strong> : S=C3=A9l=
ectionnez le mod=C3=A8le <strong data-start=3D"2368" data-end=3D"2378">Kanb=
an</strong>.</p>
</li>
<li data-start=3D"2380" data-end=3D"2465" class=3D"">
<p data-start=3D"2382" data-end=3D"2465" class=3D""><strong data-start=3D"2=
