<li data-start=3D"4696" data-end=3D"4721" class=3D"">
<p data-start=3D"4698" data-end=3D"4721" class=3D""><strong data-start=3D"4=
698" data-end=3D"4712">Bordures :</strong> <code data-start=3D"4713" data-e=
nd=3D"4721">border</code></p>
</li>
<li data-start=3D"4722" data-end=3D"4749" class=3D"">
<p data-start=3D"4724" data-end=3D"4749" class=3D""><strong data-start=3D"4=
724" data-end=3D"4739">Affichage :</strong> <code data-start=3D"4740" data-=
end=3D"4749">display</code></p>
</li>
</ul>
