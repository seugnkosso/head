</li>
<li data-start=3D"4534" data-end=3D"4583" class=3D"">
<p data-start=3D"4536" data-end=3D"4583" class=3D""><strong data-start=3D"4=
536" data-end=3D"4563">Marges et espacements :</strong> <code data-start=3D=
"4564" data-end=3D"4572">margin</code>, <code data-start=3D"4574" data-end=
=3D"4583">padding</code></p>
</li>
<li data-start=3D"4584" data-end=3D"4624" class=3D"">
<p data-start=3D"4586" data-end=3D"4624" class=3D""><strong data-start=3D"4=
586" data-end=3D"4611">Alignement du texte :</strong> <code data-start=3D"4=
