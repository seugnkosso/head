<li data-start=3D"4413" data-end=3D"4445" class=3D"">
<p data-start=3D"4415" data-end=3D"4445" class=3D""><strong data-start=3D"4=
415" data-end=3D"4437">Couleur du texte :</strong> <code data-start=3D"4438=
" data-end=3D"4445">color</code></p>
</li>
<li data-start=3D"4446" data-end=3D"4488" class=3D"">
<p data-start=3D"4448" data-end=3D"4488" class=3D""><strong data-start=3D"4=
448" data-end=3D"4469">Couleur de fond :</strong> <code data-start=3D"4470"=
 data-end=3D"4488">background-color</code></p>
</li>
<li data-start=3D"4489" data-end=3D"4533" class=3D"">
<p data-start=3D"4491" data-end=3D"4533" class=3D""><strong data-start=3D"4=
