<li data-start=3D"3528" data-end=3D"3553" class=3D"">
<p data-start=3D"3530" data-end=3D"3553" class=3D"">Sp=C3=A9cificit=C3=A9 :=
 <code data-start=3D"3544" data-end=3D"3553">0,0,0,1</code></p>
</li>
