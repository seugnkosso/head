<h3 data-start=3D"1696" data-end=3D"1712">Conditions :</h3>
<ul data-start=3D"1713" data-end=3D"1856">
<li data-start=3D"1713" data-end=3D"1772">
<p data-start=3D"1715" data-end=3D"1772">La classe doit <strong data-start=
=3D"1730" data-end=3D"1772">impl=C3=A9menter l=E2=80=99interface <code data=
-start=3D"1756" data-end=3D"1770">Serializable</code></strong></p>
</li>
<li data-start=3D"1773" data-end=3D"1856">
<p data-start=3D"1775" data-end=3D"1856">Toutes ses propri=C3=A9t=C3=A9s do=
ivent aussi =C3=AAtre <code data-start=3D"1816" data-end=3D"1830">Serializa=
ble</code> (ou marqu=C3=A9es <code data-start=3D"1844" data-end=3D"1855">tr=
ansient</code>)</p>
</li>
</ul>
