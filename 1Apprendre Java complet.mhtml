<h3 data-start=3D"2532" data-end=3D"2586" class=3D"">1.2. Explication des =
=C3=A9l=C3=A9ments du fichier <code data-start=3D"2577" data-end=3D"2586">p=
om.xml</code></h3>
<ul data-start=3D"2588" data-end=3D"3304">
<li data-start=3D"2588" data-end=3D"2681" class=3D"">
<p data-start=3D"2590" data-end=3D"2681" class=3D""><strong data-start=3D"2=
