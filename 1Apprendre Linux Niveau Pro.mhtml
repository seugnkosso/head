<ol data-start=3D"1573" data-end=3D"1958">
<li data-start=3D"1573" data-end=3D"1686" class=3D"">
<p data-start=3D"1576" data-end=3D"1686" class=3D"">Le premier caract=C3=A8=
re repr=C3=A9sente le type de fichier (<code data-start=3D"1628" data-end=
=3D"1631">-</code> pour un fichier normal, <code data-start=3D"1656" data-e=
nd=3D"1659">d</code> pour un r=C3=A9pertoire, etc.).</p>
</li>
<li data-start=3D"1687" data-end=3D"1782" class=3D"">
<p data-start=3D"1690" data-end=3D"1782" class=3D"">Les trois premiers cara=
ct=C3=A8res suivants repr=C3=A9sentent les permissions du propri=C3=A9taire=
 (<code data-start=3D"1775" data-end=3D"1780">rwx</code>).</p>
</li>
<li data-start=3D"1783" data-end=3D"1863" class=3D"">
<p data-start=3D"1786" data-end=3D"1863" class=3D"">Les trois caract=C3=A8r=
es suivants repr=C3=A9sentent les permissions du groupe (<code data-start=
=3D"1856" data-end=3D"1861">r-x</code>).</p>
</li>
<li data-start=3D"1864" data-end=3D"1958" class=3D"">
<p data-start=3D"1867" data-end=3D"1958" class=3D"">Les trois derniers cara=
ct=C3=A8res repr=C3=A9sentent les permissions des autres utilisateurs (<cod=
e data-start=3D"1951" data-end=3D"1956">r--</code>).</p>
</li>
</ol>
