<hr data-start=3D"3439" data-end=3D"3442">
<h3 data-start=3D"3444" data-end=3D"3463">2. Explications</h3>
<ul data-start=3D"3465" data-end=3D"3721">
<li data-start=3D"3465" data-end=3D"3503">
<p data-start=3D"3467" data-end=3D"3503"><code data-start=3D"3467" data-end=
=3D"3481">createMock()</code> cr=C3=A9e un objet simul=C3=A9.</p>
</li>
<li data-start=3D"3504" data-end=3D"3572">
<p data-start=3D"3506" data-end=3D"3572"><code data-start=3D"3506" data-end=
=3D"3530">expects($this-&gt;once())</code> pr=C3=A9cise qu=E2=80=99on s=E2=
=80=99attend =C3=A0 un appel unique.</p>
</li>
<li data-start=3D"3573" data-end=3D"3617">
<p data-start=3D"3575" data-end=3D"3617"><code data-start=3D"3575" data-end=
=3D"3591">method('send')</code> cible la m=C3=A9thode simul=C3=A9e.</p>
</li>
<li data-start=3D"3618" data-end=3D"3663">
<p data-start=3D"3620" data-end=3D"3663"><code data-start=3D"3620" data-end=
=3D"3631">with(...)</code> d=C3=A9finit les arguments attendus.</p>
</li>
<li data-start=3D"3664" data-end=3D"3721">
<p data-start=3D"3666" data-end=3D"3721"><code data-start=3D"3666" data-end=
=3D"3684">willReturn(true)</code> d=C3=A9finit la valeur de retour simul=C3=
=A9e.</p>
</li>
</ul>
