<h4 data-start=3D"4242" data-end=3D"4260" class=3D"">Explication :</h4>
<ul data-start=3D"4261" data-end=3D"4663">
<li data-start=3D"4261" data-end=3D"4381" class=3D"">
<p data-start=3D"4263" data-end=3D"4381" class=3D""><strong data-start=3D"4=
