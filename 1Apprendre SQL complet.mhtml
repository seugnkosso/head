<hr data-start=3D"6141" data-end=3D"6144">
<h1 data-start=3D"6146" data-end=3D"6193">=F0=9F=8E=93 Du mod=C3=A8le conce=
ptuel au sch=C3=A9ma relationnel</h1>
<h3 data-start=3D"6195" data-end=3D"6237">=C3=89tapes de mod=C3=A9lisation =
relationnelle :</h3>
<ol data-start=3D"6239" data-end=3D"6553">
<li data-start=3D"6239" data-end=3D"6288">
<p data-start=3D"6242" data-end=3D"6288"><strong data-start=3D"6242" data-e=
nd=3D"6272">Identification des entit=C3=A9s</strong> (objets m=C3=A9tier)</=
p>
