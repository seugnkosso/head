<ul data-start=3D"1427" data-end=3D"1720">
<li data-start=3D"1427" data-end=3D"1494">
<p data-start=3D"1429" data-end=3D"1494">Elles permettent <strong data-star=
t=3D"1446" data-end=3D"1473">l=E2=80=99identification unique</strong> d=E2=
=80=99un enregistrement.</p>
</li>
<li data-start=3D"1495" data-end=3D"1574">
<p data-start=3D"1497" data-end=3D"1574">Elles sont n=C3=A9cessaires pour <=
strong data-start=3D"1525" data-end=3D"1555">les relations entre tables</st=
rong> (cl=C3=A9s =C3=A9trang=C3=A8res).</p>
</li>
<li data-start=3D"1575" data-end=3D"1640">
<p data-start=3D"1577" data-end=3D"1640">Elles assurent la <strong data-sta=
rt=3D"1595" data-end=3D"1608">coh=C3=A9rence</strong> et <strong data-start=
=3D"1612" data-end=3D"1627">l=E2=80=99int=C3=A9grit=C3=A9</strong> des donn=
=C3=A9es.</p>
</li>
<li data-start=3D"1641" data-end=3D"1720">
<p data-start=3D"1643" data-end=3D"1720">Elles facilitent les <strong data-=
start=3D"1664" data-end=3D"1694">op=C3=A9rations de modification</strong> o=
u de suppression cibl=C3=A9e.</p>
</li>
</ul>
