4182" data-end=3D"4206">3.1 Routage statique</strong></h3>
<ul data-start=3D"4209" data-end=3D"4317">
<li data-start=3D"4209" data-end=3D"4244" class=3D"">
<p data-start=3D"4211" data-end=3D"4244" class=3D"">Routes configur=C3=A9es=
 manuellement</p>
</li>
<li data-start=3D"4245" data-end=3D"4317" class=3D"">
<p data-start=3D"4247" data-end=3D"4317" class=3D"">Simplicit=C3=A9, mais m=
aintenance lourde dans les grandes infrastructures</p>
</li>
</ul>
<h3 data-start=3D"4319" data-end=3D"4350" class=3D""><strong data-start=3D"=
4323" data-end=3D"4348">3.2 Routage dynamique</strong></h3>
<ul data-start=3D"4351" data-end=3D"4476">
<li data-start=3D"4351" data-end=3D"4429" class=3D"">
<p data-start=3D"4353" data-end=3D"4429" class=3D"">Mise =C3=A0 jour automa=
