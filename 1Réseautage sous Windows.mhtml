762" data-end=3D"4789">Modifier les propri=C3=A9t=C3=A9s</strong> :</p>
<ul data-start=3D"4795" data-end=3D"5054">
<li data-start=3D"4795" data-end=3D"4867" class=3D"">
<p data-start=3D"4797" data-end=3D"4867" class=3D"">Faites un clic droit su=
r l'utilisateur et s=C3=A9lectionnez <strong data-start=3D"4852" data-end=
=3D"4866">Propri=C3=A9t=C3=A9s</strong>.</p>
</li>
<li data-start=3D"4871" data-end=3D"5054" class=3D"">
<p data-start=3D"4873" data-end=3D"5054" class=3D"">Vous pouvez maintenant =
modifier des informations comme l'adresse e-mail, le groupe auquel il appar=
tient, ou des options de s=C3=A9curit=C3=A9 comme l'activation ou la d=C3=
=A9sactivation du compte.</p>
</li>
</ul>
</li>
</ol>
<h3 data-start=3D"5056" data-end=3D"5105" class=3D""><strong data-start=3D"=
5060" data-end=3D"5105">d. D=C3=A9sactiver ou supprimer un utilisateur</str=
ong></h3>
<ol data-start=3D"5107" data-end=3D"5460">
<li data-start=3D"5107" data-end=3D"5278" class=3D"">
<p data-start=3D"5110" data-end=3D"5136" class=3D""><strong data-start=3D"5=
110" data-end=3D"5134">D=C3=A9sactiver un compte</strong> :</p>
<ul data-start=3D"5140" data-end=3D"5278">
<li data-start=3D"5140" data-end=3D"5278" class=3D"">
<p data-start=3D"5142" data-end=3D"5278" class=3D"">Si vous devez d=C3=A9sa=
ctiver temporairement un utilisateur, faites un clic droit sur l'utilisateu=
r et s=C3=A9lectionnez <strong data-start=3D"5253" data-end=3D"5277">D=C3=
=A9sactiver le compte</strong>.</p>
</li>
</ul>
</li>
<li data-start=3D"5280" data-end=3D"5460" class=3D"">
<p data-start=3D"5283" data-end=3D"5313" class=3D""><strong data-start=3D"5=
283" data-end=3D"5311">Supprimer un utilisateur</strong> :</p>
<ul data-start=3D"5317" data-end=3D"5460">
<li data-start=3D"5317" data-end=3D"5460" class=3D"">
<p data-start=3D"5319" data-end=3D"5460" class=3D"">Si vous devez supprimer=
 un utilisateur, faites un clic droit sur son nom et choisissez <strong dat=
a-start=3D"5406" data-end=3D"5419">Supprimer</strong>. Vous serez invit=C3=
=A9 =C3=A0 confirmer l'action.</p>
</li>
</ul>
</li>
</ol>
<hr data-start=3D"5462" data-end=3D"5465" class=3D"">
<h2 data-start=3D"5467" data-end=3D"5518" class=3D""><strong data-start=3D"=
5470" data-end=3D"5518">4. Gestion des groupes dans Active Directory</stron=
g></h2>
<h3 data-start=3D"5520" data-end=3D"5569" class=3D""><strong data-start=3D"=
5524" data-end=3D"5569">a. Types de groupes dans Active Directory</strong><=
/h3>
<p data-start=3D"5571" data-end=3D"5716" class=3D"">Active Directory utilis=
e des groupes pour attribuer des permissions d'acc=C3=A8s et organiser les =
utilisateurs. Il existe plusieurs types de groupes :</p>
<ul data-start=3D"5718" data-end=3D"6024">
<li data-start=3D"5718" data-end=3D"5936" class=3D"">
<p data-start=3D"5720" data-end=3D"5936" class=3D""><strong data-start=3D"5=
720" data-end=3D"5743">Groupes de s=C3=A9curit=C3=A9</strong> : Ces groupes=
 sont utilis=C3=A9s pour attribuer des permissions aux utilisateurs. Par ex=
emple, un groupe de s=C3=A9curit=C3=A9 peut =C3=AAtre attribu=C3=A9 =C3=A0 =
un dossier r=C3=A9seau pour permettre =C3=A0 ses membres d'y acc=C3=A9der.<=
/p>
</li>
<li data-start=3D"5937" data-end=3D"6024" class=3D"">
<p data-start=3D"5939" data-end=3D"6024" class=3D""><strong data-start=3D"5=
939" data-end=3D"5966">Groupes de distribution</strong> : Utilis=C3=A9s pri=
ncipalement pour la distribution d'e-mails.</p>
</li>
</ul>
<h3 data-start=3D"6026" data-end=3D"6074" class=3D""><strong data-start=3D"=
6030" data-end=3D"6074">b. Cr=C3=A9er un groupe dans Active Directory</stro=
ng></h3>
<ol data-start=3D"6076" data-end=3D"6525">
<li data-start=3D"6076" data-end=3D"6198" class=3D"">
<p data-start=3D"6079" data-end=3D"6117" class=3D""><strong data-start=3D"6=
079" data-end=3D"6115">S=C3=A9lectionner l'OU pour le groupe</strong> :</p>
<ul data-start=3D"6121" data-end=3D"6198">
<li data-start=3D"6121" data-end=3D"6194" class=3D"">
<p data-start=3D"6123" data-end=3D"6194" class=3D"">Ouvrez <strong data-sta=
rt=3D"6130" data-end=3D"6138">ADUC</strong> et s=C3=A9lectionnez l'OU o=C3=
=B9 vous souhaitez cr=C3=A9er le groupe.</p>
</li>
</ul>
</li>
<li data-start=3D"6199" data-end=3D"6447" class=3D"">
<p data-start=3D"6202" data-end=3D"6223" class=3D""><strong data-start=3D"6=
202" data-end=3D"6221">Cr=C3=A9er un groupe</strong> :</p>
<ul data-start=3D"6227" data-end=3D"6447">
<li data-start=3D"6227" data-end=3D"6298" class=3D"">
<p data-start=3D"6229" data-end=3D"6298" class=3D"">Faites un clic droit su=
r l'OU et choisissez <strong data-start=3D"6273" data-end=3D"6284">Nouveau<=
/strong> &gt; <strong data-start=3D"6287" data-end=3D"6297">Groupe</strong>=
.</p>
</li>
<li data-start=3D"6302" data-end=3D"6381" class=3D"">
<p data-start=3D"6304" data-end=3D"6381" class=3D"">Saisissez le nom du gro=
upe et d=C3=A9finissez son type (s=C3=A9curit=C3=A9 ou distribution).</p>
</li>
<li data-start=3D"6385" data-end=3D"6447" class=3D"">
<p data-start=3D"6387" data-end=3D"6447" class=3D"">Choisissez la port=C3=
=A9e du groupe (local, global ou universel).</p>
</li>
</ul>
</li>
<li data-start=3D"6449" data-end=3D"6525" class=3D"">
<p data-start=3D"6452" data-end=3D"6479" class=3D""><strong data-start=3D"6=
452" data-end=3D"6477">Finaliser la cr=C3=A9ation</strong> :</p>
<ul data-start=3D"6483" data-end=3D"6525">
<li data-start=3D"6483" data-end=3D"6525" class=3D"">
<p data-start=3D"6485" data-end=3D"6525" class=3D"">Cliquez sur <strong dat=
a-start=3D"6497" data-end=3D"6503">OK</strong> pour cr=C3=A9er le groupe.</=
p>
</li>
</ul>
</li>
</ol>
<h3 data-start=3D"6527" data-end=3D"6574" class=3D""><strong data-start=3D"=
6531" data-end=3D"6574">c. Ajouter des utilisateurs =C3=A0 un groupe</stron=
g></h3>
<ol data-start=3D"6576" data-end=3D"6920">
<li data-start=3D"6576" data-end=3D"6700" class=3D"">
<p data-start=3D"6579" data-end=3D"6607" class=3D""><strong data-start=3D"6=
579" data-end=3D"6605">S=C3=A9lectionner le groupe</strong> :</p>
<ul data-start=3D"6611" data-end=3D"6700">
<li data-start=3D"6611" data-end=3D"6696" class=3D"">
<p data-start=3D"6613" data-end=3D"6696" class=3D"">Dans <strong data-start=
=3D"6618" data-end=3D"6626">ADUC</strong>, recherchez le groupe auquel vous=
 souhaitez ajouter des utilisateurs.</p>
</li>
</ul>
</li>
<li data-start=3D"6701" data-end=3D"6920" class=3D"">
<p data-start=3D"6704" data-end=3D"6729" class=3D""><strong data-start=3D"6=
704" data-end=3D"6727">Ajouter des membres</strong> :</p>
<ul data-start=3D"6733" data-end=3D"6920">
<li data-start=3D"6733" data-end=3D"6799" class=3D"">
<p data-start=3D"6735" data-end=3D"6799" class=3D"">Faites un clic droit su=
r le groupe et choisissez <strong data-start=3D"6784" data-end=3D"6798">Pro=
pri=C3=A9t=C3=A9s</strong>.</p>
</li>
<li data-start=3D"6803" data-end=3D"6920" class=3D"">
<p data-start=3D"6805" data-end=3D"6920" class=3D"">Dans l'onglet <strong d=
ata-start=3D"6819" data-end=3D"6830">Membres</strong>, cliquez sur <strong =
data-start=3D"6844" data-end=3D"6855">Ajouter</strong>, recherchez les util=
isateurs =C3=A0 ajouter, puis cliquez sur <strong data-start=3D"6913" data-=
end=3D"6919">OK</strong>.</p>
</li>
</ul>
</li>
</ol>
<h3 data-start=3D"6922" data-end=3D"6964" class=3D""><strong data-start=3D"=
6926" data-end=3D"6964">d. Modifier ou supprimer un groupe</strong></h3>
<ol data-start=3D"6966" data-end=3D"7314">
<li data-start=3D"6966" data-end=3D"7151" class=3D"">
<p data-start=3D"6969" data-end=3D"6993" class=3D""><strong data-start=3D"6=
969" data-end=3D"6991">Modifier un groupe</strong> :</p>
<ul data-start=3D"6997" data-end=3D"7151">
<li data-start=3D"6997" data-end=3D"7151" class=3D"">
<p data-start=3D"6999" data-end=3D"7151" class=3D"">Faites un clic droit su=
r le groupe et s=C3=A9lectionnez <strong data-start=3D"7050" data-end=3D"70=
64">Propri=C3=A9t=C3=A9s</strong>. Vous pouvez ajuster la port=C3=A9e ou le=
 type du groupe, ou ajouter/supprimer des membres.</p>
</li>
</ul>
</li>
<li data-start=3D"7153" data-end=3D"7314" class=3D"">
<p data-start=3D"7156" data-end=3D"7181" class=3D""><strong data-start=3D"7=
156" data-end=3D"7179">Supprimer un groupe</strong> :</p>
<ul data-start=3D"7185" data-end=3D"7314">
<li data-start=3D"7185" data-end=3D"7314" class=3D"">
<p data-start=3D"7187" data-end=3D"7314" class=3D"">Si vous n'avez plus bes=
oin du groupe, vous pouvez le supprimer en faisant un clic droit dessus et =
en choisissant <strong data-start=3D"7300" data-end=3D"7313">Supprimer</str=
ong>.</p>
</li>
</ul>
</li>
</ol>
<hr data-start=3D"7316" data-end=3D"7319" class=3D"">
<h2 data-start=3D"7321" data-end=3D"7384" class=3D""><strong data-start=3D"=
7324" data-end=3D"7384">5. S=C3=A9curiser l'acc=C3=A8s avec les strat=C3=A9=
gies de groupe (GPO)</strong></h2>
<p data-start=3D"7386" data-end=3D"7522" class=3D"">Les <strong data-start=
=3D"7390" data-end=3D"7420">Strat=C3=A9gies de groupe (GPO)</strong> permet=
tent de d=C3=A9finir des r=C3=A8gles de s=C3=A9curit=C3=A9 et de gestion de=
s utilisateurs au sein de votre domaine.</p>
<h3 data-start=3D"7524" data-end=3D"7589" class=3D""><strong data-start=3D"=
7528" data-end=3D"7589">a. Cr=C3=A9er une GPO pour appliquer une politique =
de s=C3=A9curit=C3=A9</strong></h3>
<ol data-start=3D"7591" data-end=3D"8321">
<li data-start=3D"7591" data-end=3D"7739" class=3D"">
<p data-start=3D"7594" data-end=3D"7649" class=3D""><strong data-start=3D"7=
594" data-end=3D"7647">Ouvrir la gestion des strat=C3=A9gies de groupe (GPM=
C)</strong> :</p>
<ul data-start=3D"7653" data-end=3D"7739">
<li data-start=3D"7653" data-end=3D"7739" class=3D"">
<p data-start=3D"7655" data-end=3D"7739" class=3D"">Ouvrez <strong data-sta=
rt=3D"7662" data-end=3D"7698">Gestion des strat=C3=A9gies de groupe</strong=
> =C3=A0 partir du <strong data-start=3D"7711" data-end=3D"7738">Gestionnai=
re de serveur</strong>.</p>
</li>
</ul>
</li>
<li data-start=3D"7741" data-end=3D"7897" class=3D"">
<p data-start=3D"7744" data-end=3D"7772" class=3D""><strong data-start=3D"7=
744" data-end=3D"7770">Cr=C3=A9er une nouvelle GPO</strong> :</p>
<ul data-start=3D"7776" data-end=3D"7897">
<li data-start=3D"7776" data-end=3D"7897" class=3D"">
<p data-start=3D"7778" data-end=3D"7897" class=3D"">Dans <strong data-start=
=3D"7783" data-end=3D"7791">GPMC</strong>, faites un clic droit sur votre d=
omaine et s=C3=A9lectionnez <strong data-start=3D"7848" data-end=3D"7896">C=
r=C3=A9er un GPO dans ce domaine, et le lier ici</strong>.</p>
</li>
</ul>
</li>
<li data-start=3D"7899" data-end=3D"8117" class=3D"">
<p data-start=3D"7902" data-end=3D"7925" class=3D""><strong data-start=3D"7=
902" data-end=3D"7923">Configurer la GPO</strong> :</p>
<ul data-start=3D"7929" data-end=3D"8117">
<li data-start=3D"7929" data-end=3D"8004" class=3D"">
<p data-start=3D"7931" data-end=3D"8004" class=3D"">Nommez la GPO (par exem=
ple, <strong data-start=3D"7959" data-end=3D"8002">Politiques de s=C3=A9cur=
it=C3=A9 des utilisateurs</strong>).</p>
</li>
<li data-start=3D"8008" data-end=3D"8117" class=3D"">
<p data-start=3D"8010" data-end=3D"8117" class=3D"">Configurez les param=C3=
=A8tres de s=C3=A9curit=C3=A9 (ex : politique de mot de passe, verrouillage=
 de compte) dans la GPO.</p>
</li>
</ul>
</li>
<li data-start=3D"8119" data-end=3D"8321" class=3D"">
<p data-start=3D"8122" data-end=3D"8162" class=3D""><strong data-start=3D"8=
122" data-end=3D"8160">Lier la GPO =C3=A0 une OU ou un domaine</strong> :</=
p>
<ul data-start=3D"8166" data-end=3D"8321">
<li data-start=3D"8166" data-end=3D"8321" class=3D"">
<p data-start=3D"8168" data-end=3D"8321" class=3D"">Une fois la GPO cr=C3=
=A9=C3=A9e, vous pouvez la lier =C3=A0 une unit=C3=A9 organisationnelle ou =
au domaine pour appliquer la politique aux utilisateurs ou groupes concern=
=C3=A9s.</p>
</li>
</ul>
</li>
</ol>
<hr data-start=3D"8323" data-end=3D"8326" class=3D"">
<h2 data-start=3D"8328" data-end=3D"8409" class=3D""><strong data-start=3D"=
8331" data-end=3D"8409">6. Auditer et surveiller les utilisateurs et groupe=
s dans Active Directory</strong></h2>
<p data-start=3D"8411" data-end=3D"8711" class=3D"">L'audit des activit=C3=
=A9s des utilisateurs et groupes est essentiel pour maintenir un environnem=
ent s=C3=A9curis=C3=A9. Active Directory permet de configurer des strat=C3=
=A9gies d=E2=80=99audit pour surveiller les =C3=A9v=C3=A9nements comme les =
connexions, les =C3=A9checs d'authentification, et les changements dans les=
 comptes utilisateurs.</p>
<h3 data-start=3D"8713" data-end=3D"8754" class=3D""><strong data-start=3D"=
8717" data-end=3D"8754">a. Configurer l=E2=80=99audit de s=C3=A9curit=C3=A9=
</strong></h3>
<ol data-start=3D"8756" data-end=3D"9196">
<li data-start=3D"8756" data-end=3D"8973" class=3D"">
<p data-start=3D"8759" data-end=3D"8780" class=3D""><strong data-start=3D"8=
759" data-end=3D"8778">Activer l=E2=80=99audit</strong> :</p>
<ul data-start=3D"8784" data-end=3D"8973">
<li data-start=3D"8784" data-end=3D"8893" class=3D"">
<p data-start=3D"8786" data-end=3D"8893" class=3D"">Allez dans <strong data=
-start=3D"8797" data-end=3D"8825">Panneau de configuration</strong> &gt; <s=
trong data-start=3D"8828" data-end=3D"8855">Outils d'administration</strong=
> &gt; <strong data-start=3D"8858" data-end=3D"8892">Strat=C3=A9gies de s=
=C3=A9curit=C3=A9 locales</strong>.</p>
</li>
<li data-start=3D"8897" data-end=3D"8973" class=3D"">
<p data-start=3D"8899" data-end=3D"8973" class=3D"">Activez l=E2=80=99audit=
 des =C3=A9v=C3=A9nements de connexion et d=E2=80=99=C3=A9chec d=E2=80=99au=
thentification.</p>
</li>
</ul>
</li>
<li data-start=3D"8975" data-end=3D"9196" class=3D"">
<p data-start=3D"8978" data-end=3D"9013" class=3D""><strong data-start=3D"8=
978" data-end=3D"9011">V=C3=A9rifier les journaux d=E2=80=99audit</strong> =
:</p>
<ul data-start=3D"9017" data-end=3D"9196">
<li data-start=3D"9017" data-end=3D"9196" class=3D"">
<p data-start=3D"9019" data-end=3D"9196" class=3D"">Utilisez l=E2=80=99<str=
ong data-start=3D"9030" data-end=3D"9058">Observateur d=E2=80=99=C3=A9v=C3=
=A9nements</strong> pour examiner les logs d=E2=80=99audit. Recherchez les =
=C3=A9v=C3=A9nements d'audit dans le journal de s=C3=A9curit=C3=A9 pour sui=
vre les activit=C3=A9s des utilisateurs.</p>
</li>
</ul>
</li>
</ol>
<hr data-start=3D"9198" data-end=3D"9201" class=3D"">
<h2 data-start=3D"9203" data-end=3D"9220" class=3D""><strong data-start=3D"=
9206" data-end=3D"9220">Conclusion</strong></h2>
<p data-start=3D"9222" data-end=3D"9840" class=3D"">La gestion des utilisat=
eurs et des groupes sous Active Directory est une comp=C3=A9tence fondament=
ale pour les administrateurs r=C3=A9seau. Elle permet d=E2=80=99organiser l=
es ressources, de garantir la s=C3=A9curit=C3=A9 des donn=C3=A9es et de con=
tr=C3=B4ler l=E2=80=99acc=C3=A8s au r=C3=A9seau. Avec les bonnes pratiques =
de gestion des utilisateurs et des groupes, vous pouvez simplifier la gesti=
on des permissions et renforcer la s=C3=A9curit=C3=A9 de votre infrastructu=
re. En suivant ce tutoriel, vous serez en mesure de g=C3=A9rer efficacement=
 les utilisateurs et les groupes dans un environnement Windows Server, et d=
e mettre en place une structure de s=C3=A9curit=C3=A9 adapt=C3=A9e =C3=A0 v=
os besoins.</p></div></div></div></div></div></div></div></div></article><a=
