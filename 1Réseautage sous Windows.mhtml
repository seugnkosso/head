oke=3D"currentColor" stroke-width=3D"2" stroke-linecap=3D"round" stroke-lin=
ejoin=3D"round"></path></svg>Edit</button></span></div></div></div><div cla=
ss=3D"overflow-y-auto p-4" dir=3D"ltr"><code class=3D"!whitespace-pre langu=
age-bash"><span><span>telnet localhost 3389
</span></span></code></div></div></pre>
<p data-start=3D"3042" data-end=3D"3114" class=3D"">Si telnet parvient =C3=
=A0 se connecter, cela signifie que le port est ouvert.</p>
<hr data-start=3D"3116" data-end=3D"3119" class=3D"">
<h2 data-start=3D"3121" data-end=3D"3184" class=3D""><strong data-start=3D"=
3124" data-end=3D"3184">3. Configuration du pare-feu Windows pour Remote De=
sktop</strong></h2>
<p data-start=3D"3186" data-end=3D"3363" class=3D"">Le <strong data-start=
=3D"3189" data-end=3D"3209">pare-feu Windows</strong> doit =C3=AAtre config=
ur=C3=A9 pour autoriser les connexions entrantes sur le port utilis=C3=A9 p=
ar Remote Desktop. Cela permet aux clients de se connecter sans entrave.</p=
>
<h3 data-start=3D"3365" data-end=3D"3403" class=3D""><strong data-start=3D"=
3369" data-end=3D"3403">Configurer le pare-feu Windows</strong></h3>
<ol data-start=3D"3405" data-end=3D"4306">
<li data-start=3D"3405" data-end=3D"3447" class=3D"">
<p data-start=3D"3408" data-end=3D"3447" class=3D"">Ouvrez le <strong data-=
start=3D"3418" data-end=3D"3446">Panneau de configuration</strong>.</p>
</li>
<li data-start=3D"3448" data-end=3D"3536" class=3D"">
<p data-start=3D"3451" data-end=3D"3536" class=3D"">S=C3=A9lectionnez <stro=
ng data-start=3D"3464" data-end=3D"3487">Syst=C3=A8me et s=C3=A9curit=C3=A9=
</strong>, puis cliquez sur <strong data-start=3D"3506" data-end=3D"3535">P=
are-feu Windows Defender</strong>.</p>
</li>
<li data-start=3D"3537" data-end=3D"3598" class=3D"">
<p data-start=3D"3540" data-end=3D"3598" class=3D"">Dans le volet gauche, s=
=C3=A9lectionnez <strong data-start=3D"3575" data-end=3D"3597">Param=C3=A8t=
res avanc=C3=A9s</strong>.</p>
</li>
<li data-start=3D"3599" data-end=3D"3739" class=3D"">
<p data-start=3D"3602" data-end=3D"3739" class=3D"">Dans la fen=C3=AAtre <s=
trong data-start=3D"3618" data-end=3D"3674">Pare-feu Windows avec fonctions=
 avanc=C3=A9es de s=C3=A9curit=C3=A9</strong>, s=C3=A9lectionnez <strong da=
ta-start=3D"3689" data-end=3D"3717">R=C3=A8gles de trafic entrant</strong> =
dans le volet gauche.</p>
</li>
<li data-start=3D"3740" data-end=3D"3929" class=3D"">
<p data-start=3D"3743" data-end=3D"3929" class=3D"">Recherchez une r=C3=A8g=
le appel=C3=A9e <strong data-start=3D"3772" data-end=3D"3802">Bureau =C3=A0=
 distance (TCP-In)</strong> et v=C3=A9rifiez qu'elle est activ=C3=A9e. Si l=
a r=C3=A8gle n=E2=80=99est pas activ=C3=A9e, faites un clic droit sur la r=
=C3=A8gle et s=C3=A9lectionnez <strong data-start=3D"3917" data-end=3D"3928=
">Activer</strong>.</p>
</li>
<li data-start=3D"3930" data-end=3D"4306" class=3D"">
<p data-start=3D"3933" data-end=3D"3985" class=3D"">Si la r=C3=A8gle n=E2=
=80=99existe pas, vous devrez en cr=C3=A9er une :</p>
<ul data-start=3D"3989" data-end=3D"4306">
<li data-start=3D"3989" data-end=3D"4022" class=3D"">
<p data-start=3D"3991" data-end=3D"4022" class=3D"">Cliquez sur <strong dat=
a-start=3D"4003" data-end=3D"4021">Nouvelle r=C3=A8gle</strong>.</p>
</li>
<li data-start=3D"4026" data-end=3D"4075" class=3D"">
<p data-start=3D"4028" data-end=3D"4075" class=3D"">Choisissez <strong data=
-start=3D"4039" data-end=3D"4047">Port</strong> et cliquez sur <strong data=
-start=3D"4063" data-end=3D"4074">Suivant</strong>.</p>
</li>
<li data-start=3D"4079" data-end=3D"4154" class=3D"">
<p data-start=3D"4081" data-end=3D"4154" class=3D"">S=C3=A9lectionnez <stro=
ng data-start=3D"4094" data-end=3D"4101">TCP</strong>, entrez le port <stro=
ng data-start=3D"4118" data-end=3D"4126">3389</strong> et cliquez sur <stro=
ng data-start=3D"4142" data-end=3D"4153">Suivant</strong>.</p>
</li>
<li data-start=3D"4158" data-end=3D"4216" class=3D"">
<p data-start=3D"4160" data-end=3D"4216" class=3D"">Choisissez <strong data=
-start=3D"4171" data-end=3D"4197">Autoriser la connexion</strong>, puis <st=
rong data-start=3D"4204" data-end=3D"4215">Suivant</strong>.</p>
</li>
<li data-start=3D"4220" data-end=3D"4306" class=3D"">
<p data-start=3D"4222" data-end=3D"4306" class=3D"">Donnez un nom =C3=A0 la=
 r=C3=A8gle, par exemple "Remote Desktop", et cliquez sur <strong data-star=
t=3D"4293" data-end=3D"4305">Terminer</strong>.</p>
</li>
</ul>
</li>
</ol>
<p data-start=3D"4308" data-end=3D"4391" class=3D"">Cela permettra au pare-=
feu de permettre les connexions =C3=A0 distance via le port 3389.</p>
<hr data-start=3D"4393" data-end=3D"4396" class=3D"">
<h2 data-start=3D"4398" data-end=3D"4438" class=3D""><strong data-start=3D"=
4401" data-end=3D"4438">4. S=C3=A9curisation de Remote Desktop</strong></h2=
>
<h3 data-start=3D"4440" data-end=3D"4497" class=3D""><strong data-start=3D"=
4444" data-end=3D"4497">Utilisation du chiffrement de niveau r=C3=A9seau (N=
LA)</strong></h3>
<p data-start=3D"4499" data-end=3D"4723" class=3D"">Le chiffrement de nivea=
u r=C3=A9seau (NLA) permet de s=C3=A9curiser les connexions en v=C3=A9rifia=
nt l=E2=80=99identit=C3=A9 de l=E2=80=99ordinateur avant que l=E2=80=99acc=
=C3=A8s =C3=A0 distance ne soit accord=C3=A9. Cela emp=C3=AAche les attaque=
s comme les attaques par <strong data-start=3D"4707" data-end=3D"4722">brut=
e-force</strong>.</p>
<ol data-start=3D"4725" data-end=3D"5029">
<li data-start=3D"4725" data-end=3D"4817" class=3D"">
<p data-start=3D"4728" data-end=3D"4817" class=3D"">Allez dans <strong data=
-start=3D"4739" data-end=3D"4774">Param=C3=A8tres de Bureau =C3=A0 distance=
</strong> (comme d=C3=A9crit dans la section pr=C3=A9c=C3=A9dente).</p>
</li>
<li data-start=3D"4818" data-end=3D"4927" class=3D"">
<p data-start=3D"4821" data-end=3D"4927" class=3D"">Sous les param=C3=A8tre=
s avanc=C3=A9s, assurez-vous que l'option <strong data-start=3D"4876" data-=
end=3D"4914">NLA (Network Level Authentication)</strong> est activ=C3=A9e.<=
/p>
</li>
<li data-start=3D"4928" data-end=3D"5029" class=3D"">
<p data-start=3D"4931" data-end=3D"5029" class=3D"">L=E2=80=99activation de=
 NLA emp=C3=AAche les connexions de se produire avant que l=E2=80=99authent=
ification n=E2=80=99ait lieu.</p>
</li>
</ol>
<p data-start=3D"5031" data-end=3D"5108" class=3D"">Cela constitue une s=C3=
=A9curit=C3=A9 de premier niveau pour les connexions =C3=A0 distance.</p>
<h3 data-start=3D"5110" data-end=3D"5152" class=3D""><strong data-start=3D"=
5114" data-end=3D"5152">Configurer un mot de passe robuste</strong></h3>
<p data-start=3D"5154" data-end=3D"5330" class=3D"">Il est essentiel de <st=
rong data-start=3D"5174" data-end=3D"5206">d=C3=A9finir un mot de passe for=
t</strong> pour chaque compte utilisateur ayant acc=C3=A8s =C3=A0 Remote De=
sktop. Un mot de passe robuste doit respecter les crit=C3=A8res suivants :<=
/p>
<ul data-start=3D"5331" data-end=3D"5520">
<li data-start=3D"5331" data-end=3D"5371" class=3D"">
<p data-start=3D"5333" data-end=3D"5371" class=3D""><strong data-start=3D"5=
333" data-end=3D"5345">Longueur</strong> : au moins 12 caract=C3=A8res.</p>
</li>
<li data-start=3D"5372" data-end=3D"5458" class=3D"">
<p data-start=3D"5374" data-end=3D"5458" class=3D""><strong data-start=3D"5=
374" data-end=3D"5388">Complexit=C3=A9</strong> : utiliser des majuscules, =
minuscules, chiffres et symboles sp=C3=A9ciaux.</p>
</li>
<li data-start=3D"5459" data-end=3D"5520" class=3D"">
<p data-start=3D"5461" data-end=3D"5520" class=3D""><strong data-start=3D"5=
461" data-end=3D"5489">=C3=89viter les mots courants</strong> et les combin=
aisons =C3=A9videntes.</p>
</li>
</ul>
<p data-start=3D"5522" data-end=3D"5606" class=3D"">Encouragez =C3=A9galeme=
nt les utilisateurs =C3=A0 <strong data-start=3D"5562" data-end=3D"5605">ch=
anger leur mot de passe r=C3=A9guli=C3=A8rement</strong>.</p>
<h3 data-start=3D"5608" data-end=3D"5642" class=3D""><strong data-start=3D"=
5612" data-end=3D"5642">Activer le chiffrement RDP</strong></h3>
<p data-start=3D"5644" data-end=3D"5909" class=3D"">Le protocole <strong da=
ta-start=3D"5657" data-end=3D"5690">RDP (Remote Desktop Protocol)</strong> =
est utilis=C3=A9 par Remote Desktop pour la communication entre le client e=
t le serveur. Par d=C3=A9faut, RDP chiffre les donn=C3=A9es =C3=A9chang=C3=
=A9es. Vous pouvez configurer ce chiffrement pour utiliser le niveau le plu=
s =C3=A9lev=C3=A9 disponible.</p>
<ol data-start=3D"5911" data-end=3D"6341">
<li data-start=3D"5911" data-end=3D"6028" class=3D"">
<p data-start=3D"5914" data-end=3D"6028" class=3D"">Ouvrez <strong data-sta=
rt=3D"5921" data-end=3D"5932">Regedit</strong> (=C3=89diteur du registre) e=
n tapant <code data-start=3D"5965" data-end=3D"5974">regedit</code> dans la=
 barre de recherche et en appuyant sur Entr=C3=A9e.</p>
</li>
<li data-start=3D"6029" data-end=3D"6166" class=3D"">
<p data-start=3D"6032" data-end=3D"6061" class=3D"">Allez dans la cl=C3=A9 =
suivante :</p>
