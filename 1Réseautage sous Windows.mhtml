677" data-end=3D"3706">Acc=C3=A9dez =C3=A0 Hyper-V Manager</strong> :</p>
<ul data-start=3D"3712" data-end=3D"3805">
<li data-start=3D"3712" data-end=3D"3801" class=3D"">
<p data-start=3D"3714" data-end=3D"3801" class=3D"">Lancez <strong data-sta=
rt=3D"3721" data-end=3D"3745">Gestionnaire Hyper-V</strong> depuis le menu =
D=C3=A9marrer ou <strong data-start=3D"3773" data-end=3D"3800">Gestionnaire=
 de serveur</strong>.</p>
</li>
</ul>
</li>
<li data-start=3D"3806" data-end=3D"4033" class=3D"">
<p data-start=3D"3809" data-end=3D"3871" class=3D""><strong data-start=3D"3=
809" data-end=3D"3869">Acc=C3=A9dez =C3=A0 l'option Gestionnaire de commuta=
teurs virtuels</strong> :</p>
<ul data-start=3D"3875" data-end=3D"4033">
<li data-start=3D"3875" data-end=3D"3957" class=3D"">
<p data-start=3D"3877" data-end=3D"3957" class=3D"">Dans <strong data-start=
=3D"3882" data-end=3D"3901">Hyper-V Manager</strong>, cliquez sur <strong d=
ata-start=3D"3915" data-end=3D"3956">Gestionnaire de commutateurs virtuels<=
/strong>.</p>
</li>
<li data-start=3D"3961" data-end=3D"4033" class=3D"">
<p data-start=3D"3963" data-end=3D"4033" class=3D"">Cliquez sur <strong dat=
a-start=3D"3975" data-end=3D"3986">Nouveau</strong> pour cr=C3=A9er un <str=
ong data-start=3D"4001" data-end=3D"4032">commutateur virtuel externe</stro=
ng>.</p>
</li>
</ul>
</li>
<li data-start=3D"4035" data-end=3D"4303" class=3D"">
<p data-start=3D"4038" data-end=3D"4077" class=3D""><strong data-start=3D"4=
038" data-end=3D"4075">Configurer le commutateur externe</strong> :</p>
<ul data-start=3D"4081" data-end=3D"4303">
<li data-start=3D"4081" data-end=3D"4160" class=3D"">
<p data-start=3D"4083" data-end=3D"4160" class=3D"">S=C3=A9lectionnez <stro=
ng data-start=3D"4096" data-end=3D"4107">Externe</strong> et associez-le =
=C3=A0 la carte r=C3=A9seau physique de l=E2=80=99h=C3=B4te.</p>
</li>
<li data-start=3D"4164" data-end=3D"4261" class=3D"">
<p data-start=3D"4166" data-end=3D"4261" class=3D"">Cochez la case <strong =
data-start=3D"4181" data-end=3D"4260">Autoriser le gestionnaire Hyper-V =C3=
=A0 partager cette carte r=C3=A9seau avec l=E2=80=99h=C3=B4te</strong>.</p>
</li>
<li data-start=3D"4265" data-end=3D"4303" class=3D"">
<p data-start=3D"4267" data-end=3D"4303" class=3D"">Cliquez sur <strong dat=
a-start=3D"4279" data-end=3D"4285">OK</strong> pour enregistrer.</p>
</li>
</ul>
</li>
</ol>
<h3 data-start=3D"4305" data-end=3D"4352" class=3D""><strong data-start=3D"=
4309" data-end=3D"4352">b. Cr=C3=A9er un Commutateur Virtuel Interne</stron=
g></h3>
<ol data-start=3D"4353" data-end=3D"4524">
<li data-start=3D"4353" data-end=3D"4520" class=3D"">
<p data-start=3D"4356" data-end=3D"4520" class=3D"">Suivez les m=C3=AAmes =
=C3=A9tapes que ci-dessus, mais s=C3=A9lectionnez <strong data-start=3D"441=
3" data-end=3D"4424">Interne</strong> pour permettre aux machines virtuelle=
s de communiquer avec l=E2=80=99h=C3=B4te sans acc=C3=A8s au r=C3=A9seau ex=
terne.</p>
</li>
</ol>
<h3 data-start=3D"4525" data-end=3D"4570" class=3D""><strong data-start=3D"=
4529" data-end=3D"4570">c. Cr=C3=A9er un Commutateur Virtuel Priv=C3=A9</st=
rong></h3>
<ol data-start=3D"4571" data-end=3D"4687">
<li data-start=3D"4571" data-end=3D"4687" class=3D"">
<p data-start=3D"4574" data-end=3D"4687" class=3D"">S=C3=A9lectionnez <stro=
ng data-start=3D"4587" data-end=3D"4596">Priv=C3=A9</strong> pour permettre=
 la communication uniquement entre les machines virtuelles sur le m=C3=AAme=
 h=C3=B4te.</p>
</li>
</ol>
<hr data-start=3D"4689" data-end=3D"4692" class=3D"">
<h2 data-start=3D"4694" data-end=3D"4775" class=3D""><strong data-start=3D"=
4697" data-end=3D"4775">4. Configuration de l'Adaptateur R=C3=A9seau Virtue=
l pour une Machine Virtuelle</strong></h2>
<h3 data-start=3D"4777" data-end=3D"4849" class=3D""><strong data-start=3D"=
4781" data-end=3D"4849">a. Associer un adaptateur r=C3=A9seau virtuel =C3=
=A0 une machine virtuelle</strong></h3>
<ol data-start=3D"4850" data-end=3D"5740">
<li data-start=3D"4850" data-end=3D"4946" class=3D"">
<p data-start=3D"4853" data-end=3D"4946" class=3D""><strong data-start=3D"4=
853" data-end=3D"4890">S=C3=A9lectionnez la machine virtuelle</strong> dans=
 <strong data-start=3D"4896" data-end=3D"4915">Hyper-V Manager</strong> et =
cliquez sur <strong data-start=3D"4931" data-end=3D"4945">Param=C3=A8tres</=
strong>.</p>
</li>
<li data-start=3D"4951" data-end=3D"5227" class=3D"">
<p data-start=3D"4954" data-end=3D"4990" class=3D""><strong data-start=3D"4=
954" data-end=3D"4988">Configurer l=E2=80=99adaptateur r=C3=A9seau</strong>=
 :</p>
<ul data-start=3D"4994" data-end=3D"5227">
<li data-start=3D"4994" data-end=3D"5082" class=3D"">
<p data-start=3D"4996" data-end=3D"5082" class=3D"">Dans le volet gauche de=
s param=C3=A8tres, sous <strong data-start=3D"5038" data-end=3D"5050">Mat=
=C3=A9riel</strong>, s=C3=A9lectionnez <strong data-start=3D"5065" data-end=
=3D"5081">Carte r=C3=A9seau</strong>.</p>
</li>
<li data-start=3D"5086" data-end=3D"5227" class=3D"">
<p data-start=3D"5088" data-end=3D"5227" class=3D"">Dans le menu d=C3=A9rou=
lant <strong data-start=3D"5111" data-end=3D"5134">Commutateur virtuel</str=
ong>, s=C3=A9lectionnez le <strong data-start=3D"5152" data-end=3D"5175">co=
mmutateur virtuel</strong> que vous avez cr=C3=A9=C3=A9 (ex. : externe, int=
erne, priv=C3=A9).</p>
</li>
</ul>
</li>
<li data-start=3D"5229" data-end=3D"5642" class=3D"">
<p data-start=3D"5232" data-end=3D"5277" class=3D""><strong data-start=3D"5=
232" data-end=3D"5275">Configurer le type de r=C3=A9seau pour la VM</strong=
> :</p>
<ul data-start=3D"5281" data-end=3D"5642">
<li data-start=3D"5281" data-end=3D"5390" class=3D"">
<p data-start=3D"5283" data-end=3D"5390" class=3D"">Si vous avez s=C3=A9lec=
tionn=C3=A9 un commutateur <strong data-start=3D"5323" data-end=3D"5334">ex=
terne</strong>, la VM pourra acc=C3=A9der au r=C3=A9seau physique et =C3=A0=
 Internet.</p>
</li>
<li data-start=3D"5394" data-end=3D"5519" class=3D"">
<p data-start=3D"5396" data-end=3D"5519" class=3D"">Si vous avez s=C3=A9lec=
tionn=C3=A9 un commutateur <strong data-start=3D"5436" data-end=3D"5447">in=
terne</strong>, la VM pourra communiquer avec l=E2=80=99h=C3=B4te, mais pas=
 avec le r=C3=A9seau externe.</p>
</li>
<li data-start=3D"5523" data-end=3D"5642" class=3D"">
<p data-start=3D"5525" data-end=3D"5642" class=3D"">Si vous avez s=C3=A9lec=
tionn=C3=A9 un commutateur <strong data-start=3D"5565" data-end=3D"5574">pr=
iv=C3=A9</strong>, la VM ne pourra communiquer qu'avec d'autres VMs sur le =
m=C3=AAme h=C3=B4te.</p>
</li>
</ul>
</li>
<li data-start=3D"5644" data-end=3D"5740" class=3D"">
<p data-start=3D"5647" data-end=3D"5682" class=3D""><strong data-start=3D"5=
647" data-end=3D"5680">Enregistrer et d=C3=A9marrer la VM</strong> :</p>
<ul data-start=3D"5686" data-end=3D"5740">
<li data-start=3D"5686" data-end=3D"5740" class=3D"">
<p data-start=3D"5688" data-end=3D"5740" class=3D"">Cliquez sur <strong dat=
a-start=3D"5700" data-end=3D"5706">OK</strong> et d=C3=A9marrez la machine =
virtuelle.</p>
</li>
</ul>
</li>
</ol>
<hr data-start=3D"5742" data-end=3D"5745" class=3D"">
<h2 data-start=3D"5747" data-end=3D"5809" class=3D""><strong data-start=3D"=
5750" data-end=3D"5809">5. Configuration des VLANs pour les Machines Virtue=
lles</strong></h2>
<h3 data-start=3D"5811" data-end=3D"5853" class=3D""><strong data-start=3D"=
5815" data-end=3D"5853">a. Pourquoi configurer des VLANs ?</strong></h3>
<p data-start=3D"5854" data-end=3D"6093" class=3D"">Les <strong data-start=
=3D"5858" data-end=3D"5867">VLANs</strong> permettent de diviser le r=C3=A9=
seau en segments logiques, permettant un contr=C3=B4le plus fin du trafic r=
=C3=A9seau et une meilleure isolation des ressources. Hyper-V permet d'attr=
ibuer un ID de VLAN sp=C3=A9cifique =C3=A0 chaque machine virtuelle.</p>
<h3 data-start=3D"6095" data-end=3D"6149" class=3D""><strong data-start=3D"=
6099" data-end=3D"6149">b. Configurer un VLAN dans Hyper-V pour une VM</str=
ong></h3>
<ol data-start=3D"6150" data-end=3D"6569">
<li data-start=3D"6150" data-end=3D"6218" class=3D"">
<p data-start=3D"6153" data-end=3D"6218" class=3D""><strong data-start=3D"6=
153" data-end=3D"6187">Acc=C3=A9dez =C3=A0 la machine virtuelle</strong> et=
 cliquez sur <strong data-start=3D"6203" data-end=3D"6217">Param=C3=A8tres<=
/strong>.</p>
</li>
<li data-start=3D"6223" data-end=3D"6295" class=3D"">
<p data-start=3D"6226" data-end=3D"6295" class=3D""><strong data-start=3D"6=
226" data-end=3D"6270">S=C3=A9lectionner l'adaptateur r=C3=A9seau virtuel</=
strong> de la machine virtuelle.</p>
</li>
<li data-start=3D"6297" data-end=3D"6459" class=3D"">
<p data-start=3D"6300" data-end=3D"6326" class=3D""><strong data-start=3D"6=
300" data-end=3D"6324">Configurer les VLANs</strong> :</p>
<ul data-start=3D"6330" data-end=3D"6459">
<li data-start=3D"6330" data-end=3D"6378" class=3D"">
<p data-start=3D"6332" data-end=3D"6378" class=3D"">Cochez <strong data-sta=
rt=3D"6339" data-end=3D"6377">Activer la prise en charge de VLAN</strong>.<=
/p>
</li>
<li data-start=3D"6382" data-end=3D"6459" class=3D"">
<p data-start=3D"6384" data-end=3D"6459" class=3D"">Entrez l'<strong data-s=
tart=3D"6393" data-end=3D"6404">ID VLAN</strong> souhait=C3=A9. Par exemple=
, pour un VLAN 10, entrez <strong data-start=3D"6452" data-end=3D"6458">10<=
/strong>.</p>
</li>
</ul>
</li>
<li data-start=3D"6461" data-end=3D"6569" class=3D"">
<p data-start=3D"6464" data-end=3D"6569" class=3D""><strong data-start=3D"6=
464" data-end=3D"6497">Enregistrer les modifications</strong> et <strong da=
ta-start=3D"6501" data-end=3D"6519">d=C3=A9marrer la VM</strong>. Elle sera=
 maintenant connect=C3=A9e au VLAN sp=C3=A9cifi=C3=A9.</p>
</li>
</ol>
<hr data-start=3D"6571" data-end=3D"6574" class=3D"">
<h2 data-start=3D"6576" data-end=3D"6667" class=3D""><strong data-start=3D"=
6579" data-end=3D"6667">6. Configuration du Routage et de la Passerelle ent=
re les VLANs et le R=C3=A9seau Externe</strong></h2>
<h3 data-start=3D"6669" data-end=3D"6730" class=3D""><strong data-start=3D"=
6673" data-end=3D"6730">a. Activer le Routage Inter-VLANs avec Windows Serv=
er</strong></h3>
<p data-start=3D"6731" data-end=3D"6944" class=3D"">Si vous souhaitez que l=
es machines virtuelles sur des VLANs diff=C3=A9rents communiquent entre ell=
es ou avec le r=C3=A9seau externe, vous devez configurer un serveur Windows=
 pour faire office de <strong data-start=3D"6916" data-end=3D"6927">routeur=
</strong> entre les VLANs.</p>
<ol data-start=3D"6946" data-end=3D"7593">
<li data-start=3D"6946" data-end=3D"7139" class=3D"">
<p data-start=3D"6949" data-end=3D"6995" class=3D""><strong data-start=3D"6=
949" data-end=3D"6993">Activer le routage et l'acc=C3=A8s =C3=A0 distance</=
strong> :</p>
<ul data-start=3D"6999" data-end=3D"7139">
<li data-start=3D"6999" data-end=3D"7139" class=3D"">
<p data-start=3D"7001" data-end=3D"7139" class=3D"">Dans <strong data-start=
=3D"7006" data-end=3D"7033">Gestionnaire de serveur</strong>, allez =C3=A0 =
<strong data-start=3D"7043" data-end=3D"7087">Ajouter des r=C3=B4les et des=
 fonctionnalit=C3=A9s</strong> et activez le r=C3=B4le <strong data-start=
=3D"7107" data-end=3D"7138">Routage et acc=C3=A8s =C3=A0 distance</strong>.=
</p>
</li>
</ul>
</li>
<li data-start=3D"7141" data-end=3D"7416" class=3D"">
<p data-start=3D"7144" data-end=3D"7182" class=3D""><strong data-start=3D"7=
144" data-end=3D"7180">Configurer les interfaces r=C3=A9seau</strong> :</p>
<ul data-start=3D"7186" data-end=3D"7416">
<li data-start=3D"7186" data-end=3D"7317" class=3D"">
<p data-start=3D"7188" data-end=3D"7317" class=3D"">Assurez-vous que chaque=
 carte r=C3=A9seau virtuelle associ=C3=A9e =C3=A0 un VLAN a une adresse IP =
correcte dans le m=C3=AAme sous-r=C3=A9seau que le VLAN.</p>
</li>
<li data-start=3D"7321" data-end=3D"7416" class=3D"">
<p data-start=3D"7323" data-end=3D"7416" class=3D"">Configurez <strong data=
-start=3D"7334" data-end=3D"7363">les interfaces de routage</strong> pour p=
ermettre le passage du trafic entre les VLANs.</p>
</li>
</ul>
</li>
<li data-start=3D"7418" data-end=3D"7502" class=3D"">
<p data-start=3D"7421" data-end=3D"7502" class=3D""><strong data-start=3D"7=
421" data-end=3D"7455">Configurer le routage statique</strong> ou <strong d=
ata-start=3D"7459" data-end=3D"7472">dynamique</strong> (en fonction de vos=
 besoins).</p>
</li>
<li data-start=3D"7504" data-end=3D"7593" class=3D"">
<p data-start=3D"7507" data-end=3D"7593" class=3D""><strong data-start=3D"7=
507" data-end=3D"7544">Configurer les r=C3=A8gles de pare-feu</strong> pour=
 autoriser le trafic inter-VLAN et Internet.</p>
</li>
</ol>
<hr data-start=3D"7595" data-end=3D"7598" class=3D"">
<h2 data-start=3D"7600" data-end=3D"7656" class=3D""><strong data-start=3D"=
7603" data-end=3D"7656">7. V=C3=A9rification et Surveillance du R=C3=A9seau=
