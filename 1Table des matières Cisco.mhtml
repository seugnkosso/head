<p data-start=3D"2593" data-end=3D"2968" class=3D"">1=EF=B8=8F=E2=83=A3 Ouv=
rez GNS3 et cr=C3=A9ez un <strong data-start=3D"2621" data-end=3D"2639">nou=
veau projet</strong>.<br data-start=3D"2640" data-end=3D"2643">
