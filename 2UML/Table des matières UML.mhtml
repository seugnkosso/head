<p data-start=3D"5726" data-end=3D"5752"><strong data-start=3D"5726" data-e=
nd=3D"5750">Diagramme de classes</strong> :</p>
<ul data-start=3D"5755" data-end=3D"5798">
<li data-start=3D"5755" data-end=3D"5774">
<p data-start=3D"5757" data-end=3D"5774"><code data-start=3D"5757" data-end=
=3D"5774">Classe : Client</code></p>
</li>
<li data-start=3D"5777" data-end=3D"5798">
<p data-start=3D"5779" data-end=3D"5798"><code data-start=3D"5779" data-end=
=3D"5798">Classe : Commande</code></p>
</li>
</ul>
</li>
<li data-start=3D"5800" data-end=3D"5883">
<p data-start=3D"5802" data-end=3D"5829"><strong data-start=3D"5802" data-e=
nd=3D"5827">Diagramme de s=C3=A9quence</strong> :</p>
<ul data-start=3D"5832" data-end=3D"5883">
<li data-start=3D"5832" data-end=3D"5883">
<p data-start=3D"5834" data-end=3D"5883"><code data-start=3D"5834" data-end=
=3D"5842">Client</code> =E2=86=92 <code data-start=3D"5845" data-end=3D"586=
2">ServiceCommande</code> : <code data-start=3D"5865" data-end=3D"5883">pas=
serCommande()</code></p>
</li>
</ul>
</li>
<li data-start=3D"5885" data-end=3D"5982">
<p data-start=3D"5887" data-end=3D"5916"><strong data-start=3D"5887" data-e=
nd=3D"5914">Diagramme de composants</strong> :</p>
<ul data-start=3D"5919" data-end=3D"5982">
<li data-start=3D"5919" data-end=3D"5949">
<p data-start=3D"5921" data-end=3D"5949"><code data-start=3D"5921" data-end=
=3D"5949">Composant : ModuleCommande</code></p>
</li>
<li data-start=3D"5952" data-end=3D"5982">
<p data-start=3D"5954" data-end=3D"5982">Interface <code data-start=3D"5964=
" data-end=3D"5982">passerCommande()</code></p>
</li>
</ul>
</li>
</ul>
<p data-start=3D"5984" data-end=3D"6071">=E2=9E=A1=EF=B8=8F Le m=C3=AAme co=
ncept (<code data-start=3D"6004" data-end=3D"6020">passerCommande</code>) e=
st <strong data-start=3D"6026" data-end=3D"6055">repris =C3=A0 tous les niv=
eaux</strong> avec coh=C3=A9rence.</p>
