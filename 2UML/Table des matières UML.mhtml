<hr data-start=3D"987" data-end=3D"990">
<h3 data-start=3D"992" data-end=3D"1037">=F0=9F=93=8C 1.1 Qu=E2=80=99est-ce=
 qu=E2=80=99un composant en UML ?</h3>
<p data-start=3D"1039" data-end=3D"1186">Un <strong data-start=3D"1042" dat=
a-end=3D"1059">composant UML</strong> est une <strong data-start=3D"1068" d=
ata-end=3D"1102">unit=C3=A9 modulaire de d=C3=A9ploiement</strong>, repr=C3=
=A9sentant une <strong data-start=3D"1121" data-end=3D"1142">partie encapsu=
l=C3=A9e</strong> d=E2=80=99un syst=C3=A8me logiciel, souvent associ=C3=A9e=
 =C3=A0 :</p>
<ul data-start=3D"1187" data-end=3D"1323">
<li data-start=3D"1187" data-end=3D"1226">
<p data-start=3D"1189" data-end=3D"1226">Une biblioth=C3=A8que (ex. <code d=
ata-start=3D"1211" data-end=3D"1217">.jar</code>, <code data-start=3D"1219"=
 data-end=3D"1225">.dll</code>)</p>
</li>
<li data-start=3D"1227" data-end=3D"1244">
<p data-start=3D"1229" data-end=3D"1244">Un microservice</p>
</li>
<li data-start=3D"1245" data-end=3D"1278">
<p data-start=3D"1247" data-end=3D"1278">Une couche (DAO, Service, etc.)</p=
>
</li>
<li data-start=3D"1279" data-end=3D"1323">
<p data-start=3D"1281" data-end=3D"1323">Un module (front-end, back-end, s=
=C3=A9curit=C3=A9=E2=80=A6)</p>
</li>
</ul>
