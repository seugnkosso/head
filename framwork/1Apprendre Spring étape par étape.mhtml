        </span><span><span class=3D"hljs-keyword">try</span></span><span> {
            </span><span><span class=3D"hljs-comment">// Etape 1 : D=C3=A9m=
arrer une transaction</span></span><span>
            em.getTransaction().begin();

            </span><span><span class=3D"hljs-comment">// Etape 2 : Ex=C3=A9=
cuter des op=C3=A9rations de persistance</span></span><span>
            </span><span><span class=3D"hljs-type">Personne</span></span><s=
