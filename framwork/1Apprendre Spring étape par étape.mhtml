            p.setNom(</span><span><span class=3D"hljs-string">"Dupont"</spa=
n></span><span>);
            em.persist(p);

            </span><span><span class=3D"hljs-comment">// Etape 3 : Commit d=
e la transaction</span></span><span>
            em.getTransaction().commit();
            System.out.println(</span><span><span class=3D"hljs-string">"Tr=
ansaction valid=C3=A9e avec succ=C3=A8s."</span></span><span>);

        } </span><span><span class=3D"hljs-keyword">catch</span></span><spa=
n> (RuntimeException e) {
            </span><span><span class=3D"hljs-comment">// En cas d'erreur, r=
ollback</span></span><span>
            </span><span><span class=3D"hljs-keyword">if</span></span><span=
> (em.getTransaction().isActive()) {
                em.getTransaction().rollback();
                System.out.println(</span><span><span class=3D"hljs-string"=
>"Transaction annul=C3=A9e."</span></span><span>);
            }
            e.printStackTrace();
        } </span><span><span class=3D"hljs-keyword">finally</span></span><s=
pan> {
            em.close();
            emf.close();
        }
    }
}
