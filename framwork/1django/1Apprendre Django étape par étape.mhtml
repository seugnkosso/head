<ul data-start=3D"1080" data-end=3D"1149">
<li data-start=3D"1080" data-end=3D"1099">
<p data-start=3D"1082" data-end=3D"1099"><code data-start=3D"1082" data-end=
=3D"1099">add_&lt;modelname&gt;</code></p>
</li>
<li data-start=3D"1102" data-end=3D"1124">
<p data-start=3D"1104" data-end=3D"1124"><code data-start=3D"1104" data-end=
=3D"1124">change_&lt;modelname&gt;</code></p>
</li>
<li data-start=3D"1127" data-end=3D"1149">
<p data-start=3D"1129" data-end=3D"1149"><code data-start=3D"1129" data-end=
=3D"1149">delete_&lt;modelname&gt;</code></p>
</li>
</ul>
</li>
<li data-start=3D"1150" data-end=3D"1214">
<p data-start=3D"1152" data-end=3D"1214">Ces permissions sont stock=C3=A9es=
 dans la table <code data-start=3D"1196" data-end=3D"1213">auth_permission<=
/code>.</p>
</li>
<li data-start=3D"1215" data-end=3D"1266">
