822" data-end=3D"3836">{% static %}</code>.</p>
<hr data-start=3D"3839" data-end=3D"3842">
<h2 data-start=3D"3844" data-end=3D"3875">=F0=9F=9A=80 8. Optimisations ava=
nc=C3=A9es</h2>
<h3 data-start=3D"3877" data-end=3D"3911">a. Compression et minification</h=
3>
<p data-start=3D"3913" data-end=3D"3952">Vous pouvez utiliser des outils co=
mme :</p>
<ul data-start=3D"3954" data-end=3D"4135">
<li data-start=3D"3954" data-end=3D"4044">
<p data-start=3D"3956" data-end=3D"4044"><strong data-start=3D"3956" data-e=
nd=3D"3977">Django Compressor</strong> : compresse automatiquement les fich=
iers CSS/JS dans les templates</p>
</li>
<li data-start=3D"4045" data-end=3D"4135">
<p data-start=3D"4047" data-end=3D"4135"><strong data-start=3D"4047" data-e=
nd=3D"4061">Whitenoise</strong> : sert les fichiers statiques en production=
 sans Nginx (id=C3=A9al sur Heroku)</p>
</li>
</ul>
<h3 data-start=3D"4137" data-end=3D"4180">b. Int=C3=A9gration avec Webpack,=
 Vite, etc.</h3>
<p data-start=3D"4182" data-end=3D"4242">Django peut s=E2=80=99int=C3=A9gre=
r avec un pipeline JavaScript moderne :</p>
<ul data-start=3D"4244" data-end=3D"4405">
<li data-start=3D"4244" data-end=3D"4286">
<p data-start=3D"4246" data-end=3D"4286">Compilez vos assets dans <code dat=
a-start=3D"4271" data-end=3D"4286">frontend/dist</code></p>
</li>
<li data-start=3D"4287" data-end=3D"4351">
<p data-start=3D"4289" data-end=3D"4351">D=C3=A9clarez <code data-start=3D"=
4298" data-end=3D"4351">STATICFILES_DIRS =3D [BASE_DIR / "frontend" / "dist=
"]</code></p>
</li>
<li data-start=3D"4352" data-end=3D"4405">
<p data-start=3D"4354" data-end=3D"4405">Chargez les fichiers via <code dat=
a-start=3D"4379" data-end=3D"4405">{% static 'js/app.js' %}</code></p>
</li>
</ul>
<hr data-start=3D"4407" data-end=3D"4410">
<h2 data-start=3D"4412" data-end=3D"4474">=F0=9F=A7=B1 9. Utiliser les bali=
