<p data-start=3D"1353" data-end=3D"1380" class=3D""><strong data-start=3D"1=
353" data-end=3D"1370">Interpolation</strong> (<code data-start=3D"1372" da=
ta-end=3D"1379">{{ }}</code>)</p>
</li>
<li data-start=3D"1381" data-end=3D"1431" class=3D"">
<p data-start=3D"1383" data-end=3D"1431" class=3D""><strong data-start=3D"1=
383" data-end=3D"1403">Property Binding</strong> (<code data-start=3D"1405"=
 data-end=3D"1430">[property]=3D"expression"</code>)</p>
</li>
</ul>
