-end=3D"9191">nom-composant.component.ts</code></p>
</li>
<li data-start=3D"9192" data-end=3D"9233" class=3D"">
<p data-start=3D"9194" data-end=3D"9233" class=3D""><strong data-start=3D"9=
194" data-end=3D"9206">Services</strong> : <code data-start=3D"9209" data-e=
nd=3D"9233">nom-service.service.ts</code></p>
</li>
<li data-start=3D"9234" data-end=3D"9272" class=3D"">
<p data-start=3D"9236" data-end=3D"9272" class=3D""><strong data-start=3D"9=
